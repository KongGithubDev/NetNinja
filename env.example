# NetNinja proxy environment — real production values (Azure MalaysiaWest VM `netninja-proxy`)

# Listen ports (comma-separated supported). 443 = main proxy (plaintext HTTP CONNECT),
# 5988 = additional port to dodge ISP DPI that RSTs plaintext proxies on 443.
PORT=443,5988
BIND_ADDR=0.0.0.0

# Proxy client auth (HTTP Basic): user:pass
PROXY_USERS=Kong:KongPassword

# Admin console (/admin) BASIC auth
ADMIN_USER=admin
ADMIN_PASS=KongPassword

# Public host:port advertised in PAC/welcome flows + used to recognize self
# (e.g. when the iPad opens the dashboard through the proxy, WS absolute-form
# requests targeting this host are served locally instead of self-dialing).
PROXY_ADDR=proxy.netninja.kongwatcharapong.in.th:443

# Go runtime tuning
NET_GOGC=200
NET_MEMLIMIT=536870912

# Second-hop SOCKS5 egress (Thai VPN hop) for geo-locked / Cloudflare-blocked domains.
# DNS still resolves at the proxy; only the TCP connection leaves from the hop.
HOP_SOCKS5=172.30.77.2:1080
HOP_DOMAINS=animeruka.com,anifume.com,bilibili.tv
HOP_AUTODETECT=1

# Audit log retention (days) for conn_logs
LOG_RETENTION_DAYS=30