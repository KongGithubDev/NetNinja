{
    "log": {
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "port": 1080,
            "protocol": "socks",
            "settings": {
                "auth": "noaccount",
                "udp": true
            },
            "tag": "socks-in"
        },
        {
            "port": 1081,
            "protocol": "http",
            "settings": {},
            "tag": "http-in"
        }
    ],
    "outbounds": [
        {
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "YOUR_SERVER_IP",
                        "port": 443,
                        "users": [
                            {
                                "id": "b831381d-6324-4d53-ad4f-8cda48b30811",
                                "encryption": "none"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "ws",
                "security": "tls",
                "tlsSettings": {
                    "allowInsecure": true,
                    "serverName": "search.ais.co.th"
                },
                "wsSettings": {
                    "path": "/",
                    "headers": {
                        "Host": "search.ais.co.th"
                    }
                }
            }
        }
    ]
}