# ---------------------------------------------------------------------------
# Secrets and local machine state — never commit any of this
# ---------------------------------------------------------------------------
.env
*.key
azure-sg.key
fullchain.pem
privkey.pem

# Local deploy settings: the real server host/user lives here, never in a
# tracked script (this repository is public)
netninja.local.ps1
*.local.ps1
netninja.local.sh
*.local.sh

# Local-only notes, kept on disk and deliberately never published
TROUBLESHOOTING.md

# ---------------------------------------------------------------------------
# Per-deployment server data (scp'd by the deploy scripts, not shared)
# ---------------------------------------------------------------------------
geo-nodes.txt
geo-domains.txt
th-pool.conf
netninja-th-pool.conf

# ---------------------------------------------------------------------------
# Build output — `make` regenerates all of it into dist/
# ---------------------------------------------------------------------------
dist/
*.exe
proxy_linux*
netninja-proxy-linux
netninja-keepalive-linux

# ---------------------------------------------------------------------------
# Runtime data
# ---------------------------------------------------------------------------
proxy_cache.db
proxy_cache.db-shm
proxy_cache.db-wal

# ---------------------------------------------------------------------------
# Scratch scripts used while probing a Windows box
# ---------------------------------------------------------------------------
test_*.ps1

# ---------------------------------------------------------------------------
# Tooling and OS noise
# ---------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
.freebuff/
.claude/
.DS_Store
Thumbs.db
