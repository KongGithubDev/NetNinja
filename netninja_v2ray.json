{
  "dns": {
    "servers": ["1.1.1.1"]
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "tag": "socksinbound",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "ip": "0.0.0.0"
      }
    },
    {
      "listen": "0.0.0.0",
      "port": 8001,
      "protocol": "http",
      "tag": "httpinbound",
      "settings": {
        "timeout": 0
      }
    }
  ],
  "outbounds": [
    {
      "mux": {
        "enabled": false,
        "concurrency": 8
      },
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "sni.netninja.kongwatcharapong.in.th",
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "alterId": 0,
                "security": "auto",
                "level": 1
              }
            ],
            "port": 443
          }
        ]
      },
      "tag": "proxy",
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/",
          "headers": {
            "Host": "sni.netninja.kongwatcharapong.in.th"
          }
        },
        "security": "tls",
        "tlsSettings": {
          "allowInsecure": true,
          "serverName": "sni.netninja.kongwatcharapong.in.th"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "outboundTag": "proxy",
        "port": "0-65535"
      }
    ]
  }
}
